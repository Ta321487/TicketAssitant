<UserControl x:Class="TA_WPF.Views.RouteStatisticalAbstractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TA_WPF.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 刷新按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="刷新统计数据"
                    Margin="0,0,8,0"
                    FontSize="{Binding MainViewModel.FontSize}"
                    Foreground="{DynamicResource PrimaryHueMidBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="刷新统计" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- 卡片布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧卡片：路线缩略图 -->
            <materialDesign:Card Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Background="{DynamicResource MaterialDesignBackground}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 图片容器 -->
                    <Border Grid.Row="0"
                            Margin="16"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="4">
                        
                        <!-- 图片显示 -->
                        <Image x:Name="CoverImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <Binding Path="Route.CoverImage" Converter="{StaticResource ByteArrayToImageConverter}">
                                    <Binding.TargetNullValue>
                                        <DrawingImage />
                                    </Binding.TargetNullValue>
                                    <Binding.FallbackValue>
                                        <DrawingImage />
                                    </Binding.FallbackValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                    </Border>
                    
                    <!-- 路线名称 (显示在图片下方) -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Route.RouteName}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="16,0,16,16"
                               FontSize="{Binding MainViewModel.FontSize}"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>
            </materialDesign:Card>
            
            <!-- 右侧卡片：统计数据 -->
            <materialDesign:Card Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Background="{DynamicResource MaterialDesignBackground}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 卡片标题 -->
                    <TextBlock Grid.Row="0"
                               Text=""
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="16,16,16,8"
                               FontSize="{Binding MainViewModel.FontSize}"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    
                    <!-- 统计内容 -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,0,16,16" Orientation="Vertical">
                            <!-- 总里程 -->
                            <DockPanel Margin="0,8,0,8">
                                <TextBlock Text="总里程："
                                           FontWeight="Medium"
                                           FontSize="{Binding MainViewModel.FontSize}"
                                           Foreground="{DynamicResource MaterialDesignBody}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Statistics.TotalDistance, StringFormat={}{0:N2} 公里}"
                                           FontSize="{Binding MainViewModel.FontSize}"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                            </DockPanel>
                            
                            <!-- 总花费 -->
                            <DockPanel Margin="0,8,0,8">
                                <TextBlock Text="总花费："
                                           FontWeight="Medium"
                                           FontSize="{Binding MainViewModel.FontSize}"
                                           Foreground="{DynamicResource MaterialDesignBody}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Statistics.TotalCost, StringFormat=¥{0:N2} 元}"
                                           FontSize="{Binding MainViewModel.FontSize}"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                            </DockPanel>
                            
                            <!-- 席别统计 -->
                            <TextBlock Text="席别统计："
                                       FontWeight="Medium"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,16,0,8"/>
                            <TextBlock Text="{Binding SeatTypeStatistics}"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       TextWrapping="Wrap"
                                       Margin="16,0,0,8"/>
                            
                            <!-- 经过省份 -->
                            <TextBlock Text="经过省份："
                                       FontWeight="Medium"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,16,0,8"/>
                            <TextBlock Text="{Binding ProvincesList}"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       TextWrapping="Wrap"
                                       Margin="16,0,0,8"/>
                            
                            <!-- 经过城市 -->
                            <TextBlock Text="经过城市："
                                       FontWeight="Medium"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,16,0,8"/>
                            <TextBlock Text="{Binding CitiesList}"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       TextWrapping="Wrap"
                                       Margin="16,0,0,8"/>
                            
                            <!-- 铁路局统计 -->
                            <TextBlock Text="铁路局统计："
                                       FontWeight="Medium"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,16,0,8"/>
                            <TextBlock Text="{Binding RailwayBureauStatistics}"
                                       FontSize="{Binding MainViewModel.FontSize}"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       TextWrapping="Wrap"
                                       Margin="16,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
        
        <!-- 加载指示器 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                             Value="0" 
                             IsIndeterminate="True" 
                             Width="48" 
                             Height="48"
                             Margin="0,0,0,8"/>
                <TextBlock Text="加载中" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontWeight="Medium"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl> 