<UserControl x:Class="TA_WPF.Views.RouteMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TA_WPF.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 地图控件和加载指示器 -->
        <Grid Grid.Row="1">
            <!-- WebView2控件，用于加载高德地图 -->
            <wv2:WebView2 x:Name="MapWebView" 
                          CoreWebView2InitializationCompleted="MapWebView_CoreWebView2InitializationCompleted"
                          NavigationCompleted="MapWebView_NavigationCompleted" />
            
            <!-- 加载指示器 -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Rectangle Fill="{DynamicResource MaterialDesignPaper}" Opacity="0.7" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" IsIndeterminate="True" 
                                 Width="40" Height="40" />
                    <TextBlock Text="正在加载地图数据..." 
                               HorizontalAlignment="Center" 
                               Margin="0,16,0,0"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                </StackPanel>
            </Grid>
        </Grid>
        
        <!-- 无法加载地图时的提示消息 -->
        <Grid Grid.Row="1" x:Name="MapErrorPanel" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                         Height="48" Width="48"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="无法加载地图，请检查网络连接或高德地图API配置。" 
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" 
                           Margin="0,16,0,0"
                           FontSize="18"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <Button Content="刷新" 
                        Command="{Binding RefreshMapCommand}"
                        Margin="0,20,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl> 